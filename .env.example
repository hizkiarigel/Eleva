# Ambil API key dari https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opsional, default 3000
PORT=3000

# Postgres. Railway otomatis menyediakan ini kalau Postgres service ditambahkan
# di project yang sama (linked variable). Untuk lokal, arahkan ke Postgres kamu:
# postgres://user:password@localhost:5432/eleva_dev
DATABASE_URL=

# Kode yang dibagikan ke calon beta member — signup ditolak kalau tidak cocok.
BETA_CODE=

# String acak buat sign cookie session. Generate sekali, jangan diubah setelah
# ada user login (mengubahnya akan logout semua orang). Contoh generate:
# openssl rand -hex 32
SESSION_SECRET=

# Set "production" di hosting (Railway dkk) — mengaktifkan cookie "secure"
# (wajib HTTPS). Biarkan kosong untuk development lokal di http://localhost.
NODE_ENV=

# Opsional, dipakai scripts/generate-onboarding-audio.js sekali di dev untuk
# generate 7 file narasi onboarding (public/audio/onboarding/*.mp3) - TIDAK
# dipakai saat runtime production (audio sudah pre-generated & statis, tidak
# pernah memanggil TTS API untuk user asli). Provider belum dipilih; isi
# setelah provider dipilih (nama var generik, bukan spesifik vendor).
ONBOARDING_TTS_API_KEY=
